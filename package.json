{
  "name": "japanese-expo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-speech": "~58.0.4",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/kuromoji": "^0.1.3",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "kuromoji": "^0.1.2",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "jest",
    "build:content": "tsx scripts/build-content.ts"
  },
  "private": true,
  "jest": {
    "projects": [
      {
        "displayName": "app",
        "preset": "jest-expo",
        "testMatch": [
          "<rootDir>/src/**/*.test.ts"
        ],
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/src/$1"
        }
      },
      {
        "displayName": "scripts",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/scripts/**/*.test.ts"
        ],
        "transform": {
          "^.+.ts$": "babel-jest"
        },
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/src/$1"
        }
      }
    ]
  }
}
